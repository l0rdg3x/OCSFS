#!/bin/bash
# SPDX-License-Identifier: GPL-2.0-only
#
# ocsfs2-maint — run periodic online maintenance on every mounted OCSFS v2
# filesystem. Driven by the ocsfs2-scrub.timer / ocsfs2-defrag.timer units, or
# run by hand. All actions are ONLINE (no unmount, no downtime).
#
#   ocsfs2-maint scrub     # verify metadata checksums on each ocsfs2 mount
#   ocsfs2-maint defrag    # defragment fragmented files under each ocsfs2 mount
#
# CLUSTER COORDINATION: the timer is enabled on every node (so maintenance still
# happens if any node is down), but the work runs ONCE PER CYCLE for the whole
# cluster, on whichever node gets there first — not once per node. Two on-disk
# markers on the shared filesystem make this safe:
#   * a completion STAMP (.ocsfs2-maint.<mode>.stamp) — if maintenance completed
#     less than OCSFS2_MAINT_INTERVAL seconds ago, every node skips this cycle;
#   * an exclusive LOCK  (.ocsfs2-maint.<mode>.lock)  — an atomic O_EXCL file so
#     two nodes firing at the same instant cannot both start. OCSFS serialises
#     cross-node namespace ops, so exactly one node wins. A lock left by a
#     crashed node is stolen once it is older than OCSFS2_MAINT_STALE seconds.
#
# Tunables (env): OCSFS2_DEFRAG_MINEXT   min extents to defrag a file (def 16)
#                 OCSFS2_MAINT_INTERVAL  skip if done within N s   (def 518400 = 6d)
#                 OCSFS2_MAINT_STALE     stale-lock steal age      (def 86400  = 24h)
set -u

mode="${1:-}"
case "$mode" in
	scrub|defrag) ;;
	*) echo "usage: $0 <scrub|defrag>" >&2; exit 2 ;;
esac

minext="${OCSFS2_DEFRAG_MINEXT:-16}"
interval="${OCSFS2_MAINT_INTERVAL:-518400}"
stale="${OCSFS2_MAINT_STALE:-86400}"
me="$(hostname)/$$"
rc=0
found=0

now() { date +%s; }
epoch_of() {                 # last field of a marker file, 0 if absent/garbage
	local v; v="$(cat "$1" 2>/dev/null)"; v="${v##* }"
	case "$v" in (''|*[!0-9]*) echo 0 ;; (*) echo "$v" ;; esac
}
recent() {                   # 0 if <interval> since the stamp in $1
	[ "$(( $(now) - $(epoch_of "$1") ))" -lt "$interval" ]
}

# claim_lock <lockpath> : 0 = we own it, 1 = a live node owns it
claim_lock() {
	local lock="$1" age
	if ( set -C; printf '%s %s\n' "$me" "$(now)" > "$lock" ) 2>/dev/null; then
		return 0
	fi
	age=$(( $(now) - $(epoch_of "$lock") ))
	if [ "$age" -ge "$stale" ]; then          # crashed owner: steal it
		rm -f "$lock" 2>/dev/null || true
		( set -C; printf '%s %s\n' "$me" "$(now)" > "$lock" ) 2>/dev/null && return 0
	fi
	return 1
}

while read -r mp; do
	[ -n "$mp" ] || continue
	found=1
	# S2: keep the coordination markers in a ROOT-only dir so a non-root local
	# user can't pre-create a stamp (to suppress maintenance) or a lock. Refuse
	# the mount if the dir exists but isn't a root-owned 0700 directory.
	mdir="$mp/.ocsfs2-maint"
	if [ -e "$mdir" ] && { [ ! -d "$mdir" ] || \
	     [ "$(stat -c '%u %a' "$mdir" 2>/dev/null)" != "0 700" ]; }; then
		echo "ocsfs2-maint: $mdir is unsafe (not a root-owned 0700 dir) — skip $mp"
		rc=1
		continue
	fi
	mkdir -p "$mdir" 2>/dev/null && chown 0:0 "$mdir" && chmod 700 "$mdir" || {
		echo "ocsfs2-maint: cannot secure $mdir — skip $mp"; rc=1; continue; }
	stamp="$mdir/$mode.stamp"
	lock="$mdir/$mode.lock"

	if recent "$stamp"; then
		echo "ocsfs2-maint: $mode on $mp already done this cycle — skip"
		continue
	fi
	if ! claim_lock "$lock"; then
		echo "ocsfs2-maint: $mode on $mp running on another node — skip"
		continue
	fi
	trap 'rm -f "$lock" 2>/dev/null' EXIT
	if recent "$stamp"; then            # a peer finished while we waited
		echo "ocsfs2-maint: $mode on $mp just completed elsewhere — skip"
		rm -f "$lock" 2>/dev/null; trap - EXIT
		continue
	fi

	case "$mode" in
	scrub)
		echo "ocsfs2-maint: scrubbing $mp"
		/usr/sbin/ocsfs2-scrub "$mp" || rc=1
		;;
	defrag)
		echo "ocsfs2-maint: defragmenting $mp (min $minext extents)"
		# files actively owned by another node return -EBUSY and are skipped
		# (a running VM's disk is never relocated from elsewhere)
		/usr/sbin/ocsfs2-defrag -r -t "$minext" "$mp" || rc=1
		;;
	esac

	printf '%s %s\n' "$me" "$(now)" > "$stamp" 2>/dev/null || true  # mark cycle done
	rm -f "$lock" 2>/dev/null || true
	trap - EXIT
done < <(findmnt -rn -t ocsfs2 -o TARGET 2>/dev/null)

[ "$found" -eq 1 ] || echo "ocsfs2-maint: no ocsfs2 filesystems mounted"
exit $rc
