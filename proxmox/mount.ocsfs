#!/bin/bash
# SPDX-License-Identifier: GPL-2.0-only
#
# mount.ocsfs — Mount helper for OCSFS filesystems
#
# Called by mount(8) when invoked as:
#   mount -t ocsfs /dev/sdX /mnt/point [-o options]
#
# This helper:
#   1. Validates the block device has an OCSFS superblock
#   2. Loads the ocsfs kernel module if not already loaded
#   3. Calls the real mount(2) system call via mount(8)
#
# Install to /usr/sbin/mount.ocsfs (or /sbin/mount.ocsfs)
#

set -e

PROG="mount.ocsfs"
OCSFS_TOOL="/usr/sbin/ocsfs-tool"
KMOD="ocsfs"

usage() {
    echo "Usage: $PROG <device> <mountpoint> [-o <options>]" >&2
    exit 1
}

die() {
    echo "$PROG: $*" >&2
    exit 1
}

# Parse arguments
# mount calls us as: mount.ocsfs <device> <dir> [-o <options>]
DEVICE="$1"
MOUNTPOINT="$2"
shift 2 || usage

OPTIONS=""
while [ $# -gt 0 ]; do
    case "$1" in
        -o)
            shift
            OPTIONS="$1"
            ;;
        -n|-v|-f)
            # Standard mount flags — pass through
            ;;
        *)
            die "unknown option: $1"
            ;;
    esac
    shift
done

[ -n "$DEVICE" ]     || die "no device specified"
[ -n "$MOUNTPOINT" ] || die "no mount point specified"
[ -e "$DEVICE" ]     || die "device '$DEVICE' does not exist"
[ -d "$MOUNTPOINT" ] || die "mount point '$MOUNTPOINT' is not a directory"

# Check if device has OCSFS signature
if [ -x "$OCSFS_TOOL" ]; then
    if ! "$OCSFS_TOOL" info "$DEVICE" >/dev/null 2>&1; then
        die "device '$DEVICE' does not contain a valid OCSFS filesystem"
    fi
fi

# Load kernel module if not loaded
if ! grep -q "^$KMOD " /proc/modules 2>/dev/null; then
    modprobe "$KMOD" 2>/dev/null || \
        die "failed to load '$KMOD' kernel module"
fi

# Build mount options.
#
# IMPORTANT: pass -i ("internal" / do not invoke /sbin/mount.<type> helpers).
# Without it, mount(8) would re-discover this very helper and exec it again,
# producing infinite recursion.  -i forces the real mount(2) syscall.
MOUNT_OPTS="-i -t ocsfs"
if [ -n "$OPTIONS" ]; then
    MOUNT_OPTS="$MOUNT_OPTS -o $OPTIONS"
fi

# Perform the actual mount
exec /bin/mount $MOUNT_OPTS "$DEVICE" "$MOUNTPOINT"
