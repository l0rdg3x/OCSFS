#!/usr/bin/env python3
"""
ocsfs-fsck — Offline filesystem checker for OCSFS volumes.

Checks performed:
  1. Superblock magic and CRC32c
  2. AG descriptor magic and CRC32c
  3. Bitmap consistency + free_blocks cross-check (bitmap vs AG descriptor vs superblock)
  4. Journal header CRC32c and tail/head sanity
  5. Refcount table: no entry with block=0 but refcount>0
  6. Inode table: magic, CRC32c, orphan detection (with -r repair)
  7. Heartbeat area: magic and CRC32c for each node slot
  8. Lock table: detect stale EX/SH locks (with -r auto-downgrade to NL)
  9. Node slot table: CRC32c, detect stale ACTIVE entries (with -r mark DEAD)

Usage: ocsfs-fsck [-n] [-r] [-v] <device_or_image>
  -n  dry-run (never write, overrides -r)
  -r  repair recoverable errors (stale locks, orphans, stale node slots)
  -v  verbose output

Exit codes: 0=clean, 1=errors found (fixed or not), 2=fatal/usage error
"""

import sys
import os
import struct
import argparse
import binascii

# ── Constants from ocsfs.h ────────────────────────────────────────────────────
OCSFS_MAGIC             = 0x4F435346
OCSFS_AG_MAGIC          = 0x41474850   # 'AGHD'
OCSFS_INODE_MAGIC       = 0x494E4F44   # 'INOD'
OCSFS_JOURNAL_MAGIC     = 0x4F434A4C
OCSFS_HEARTBEAT_MAGIC   = 0x48425454   # 'HBTT'
OCSFS_LOCK_MAGIC        = 0x4C4F434B   # 'LOCK'
OCSFS_REFCOUNT_MAGIC    = 0x52454643
DEFAULT_BLOCK_SIZE      = 4096
OCSFS_VERSION_MAJOR     = 0
OCSFS_SUPERBLOCK_SIZE   = 4096
OCSFS_INODE_SIZE        = 512
OCSFS_NODE_SLOT_SIZE    = 256           # sizeof(ocsfs_disk_node_slot)
OCSFS_NODE_SLOT_TABLE_OFF = 8192
OCSFS_HEARTBEAT_OFF     = 73728
OCSFS_HEARTBEAT_ENTRY   = 1024
OCSFS_LOCK_TABLE_OFF    = 335872
OCSFS_LOCK_ENTRY_SIZE   = 256
OCSFS_IFLAG_ORPHAN      = 0x0001

# Lock modes
LOCK_MODES = {0: "NL", 1: "SH", 2: "EX", 3: "CW"}

# Node states
NODE_STATES = {0: "FREE", 1: "ACTIVE", 2: "EVICTING", 3: "SUSPECTED", 0xFF: "DEAD"}

# Superblock header (struct ocsfs_superblock, __packed, 4096 bytes).
# s_checksum lives at the very end (offset OCSFS_SUPERBLOCK_SIZE - 4 = 4092),
# NOT inside this header — read it separately. CRC32C covers bytes 0..4091.
SB_HDR_FMT = "<IHH16s64sIIQQIQHQIIIQQQQQQQIQQQIQIQ"
SB_HDR_FIELDS = [
    "s_magic","s_version_major","s_version_minor","s_uuid","s_label",
    "s_block_size","s_extent_size","s_total_blocks","s_free_blocks",
    "s_ag_count","s_ag_size","s_max_nodes","s_feature_flags",
    "s_heartbeat_interval","s_heartbeat_timeout","s_journal_size",
    "s_lock_table_off","s_journal_off","s_ag_desc_off","s_data_off",
    "s_mkfs_time","s_mount_count","s_last_mount_time","s_revision_level",
    "s_feature_compat","s_feature_incompat","s_feature_ro_compat",
    "s_lock_primary_count","s_dedup_index_root",
    "s_ag_desc_primary_count","s_ag_desc_ext_off",
]

# B+ tree on-disk node header (struct ocsfs_btree_node_hdr, __packed, 56 bytes).
BTREE_HDR_FMT = "<IHHHHIQQQQII"
BTREE_HDR_FIELDS = [
    "bn_magic","bn_flags","bn_count","bn_level","bn_reserved",
    "bn_block_size","bn_block_num","bn_parent","bn_left_sibling",
    "bn_right_sibling","bn_checksum","bn_padding",
]
BTREE_HDR_SIZE          = 56
OCSFS_BTREE_LEAF_MAGIC     = 0x42544E4C   # 'BTNL'
OCSFS_BTREE_INTERNAL_MAGIC = 0x42544E49   # 'BTNI'
OCSFS_FEATURE_RO_COMPAT_DEDUP_INDEX = (1 << 3)

# AG descriptor header (struct ocsfs_ag_desc, __packed, occupies a 4096-byte
# block). ag_checksum is at offset 4092; CRC32C covers bytes 0..4091.
# ag_bitmap_off / ag_inode_table_off are AG-RELATIVE: absolute device offset =
# ag_block_start * block_size + relative_off.
AG_HDR_FMT = "<IIQQQQQQQQQQQHHQ"
AG_HDR_FIELDS = [
    "ag_magic","ag_number","ag_block_start","ag_block_count","ag_free_blocks",
    "ag_free_extents","ag_bitmap_off","ag_bitmap_size","ag_inode_table_off",
    "ag_inode_count","ag_free_inodes","ag_extent_tree_off","ag_inode_btree_off",
    "ag_owner_node","ag_flags","ag_rc_btree_root",
]

# Node slot layout (256 bytes total)
NS_FMT    = "<16s64sBBHIQQQ32sI104sI"
NS_FIELDS = ["ns_uuid","ns_name","ns_state","ns_reserved1","ns_slot_id",
             "ns_mount_gen","ns_mount_time","ns_last_heartbeat","ns_pr_key",
             "ns_auth_token","ns_version","ns_reserved2","ns_checksum"]


_CRC32C_TABLE = []
def _crc32c_init():
    for i in range(256):
        c = i
        for _ in range(8):
            c = (c >> 1) ^ 0x82F63B78 if (c & 1) else c >> 1
        _CRC32C_TABLE.append(c & 0xFFFFFFFF)
_crc32c_init()

def crc32c(data: bytes) -> int:
    """CRC32C (Castagnoli) matching the ocsfs kernel/userspace convention.

    binascii.crc32 uses the zlib polynomial (0xEDB88320), NOT Castagnoli, so it
    can never match on-disk checksums.  The kernel and mkfs use crc32c with an
    initial value of 0xFFFFFFFF and NO final inversion (raw), so do the same:
    initialise to 0xFFFFFFFF and return the value without complementing it.
    """
    crc = 0xFFFFFFFF
    for b in data:
        crc = _CRC32C_TABLE[(crc ^ b) & 0xFF] ^ (crc >> 8)
    return crc & 0xFFFFFFFF


def read_at(f, offset: int, size: int) -> bytes:
    f.seek(offset)
    d = f.read(size)
    if len(d) < size:
        raise OSError(f"Short read at offset {offset}: got {len(d)}, want {size}")
    return d


def read_block(f, block_no: int, bs: int) -> bytes:
    return read_at(f, block_no * bs, bs)


class Fsck:
    def __init__(self, path: str, dry_run: bool, verbose: bool, repair: bool):
        self.path = path
        self.dry_run = dry_run
        self.verbose = verbose
        self.repair = repair and not dry_run
        self.errors = 0
        self.warnings = 0
        self.fixed = 0

    def log(self, msg: str):
        if self.verbose:
            print(f"  {msg}")

    def warn(self, msg: str):
        print(f"WARNING: {msg}")
        self.warnings += 1

    def error(self, msg: str):
        print(f"ERROR: {msg}")
        self.errors += 1

    def fix(self, msg: str):
        print(f"FIXED: {msg}")
        self.fixed += 1

    def check(self) -> int:
        mode = "rb+" if self.repair else "rb"
        try:
            with open(self.path, mode) as f:
                self._check_all(f)
        except OSError as e:
            print(f"FATAL: {e}", file=sys.stderr)
            return 2
        summary = f"{self.errors} error(s), {self.warnings} warning(s)"
        if self.fixed:
            summary += f", {self.fixed} fixed"
        if self.errors:
            print(f"\nfsck: {summary} — filesystem needs repair")
            return 1
        if self.warnings or self.fixed:
            print(f"\nfsck: clean ({summary})")
        else:
            print("\nfsck: clean")
        return 0

    def _check_all(self, f):
        # ── 1. Superblock ──────────────────────────────────────────────────────
        print("Checking superblock...")
        sb_raw = read_at(f, 0, OCSFS_SUPERBLOCK_SIZE)
        fields = dict(zip(SB_HDR_FIELDS, struct.unpack_from(SB_HDR_FMT, sb_raw)))
        # s_checksum is at the tail of the 4096-byte superblock, not in the header.
        fields["s_checksum"], = struct.unpack_from("<I", sb_raw,
                                                    OCSFS_SUPERBLOCK_SIZE - 4)

        if fields["s_magic"] != OCSFS_MAGIC:
            self.error(f"Bad magic: 0x{fields['s_magic']:08X} (expect 0x{OCSFS_MAGIC:08X})")
            return  # fatal — can't trust anything else
        self.log("magic OK")

        if fields["s_version_major"] != OCSFS_VERSION_MAJOR:
            self.error(f"Unsupported version {fields['s_version_major']}.{fields['s_version_minor']}")
            return

        stored_crc = fields["s_checksum"]
        computed   = crc32c(sb_raw[:OCSFS_SUPERBLOCK_SIZE - 4])
        if stored_crc != computed:
            self.error(f"Superblock CRC mismatch: stored={stored_crc:08X} computed={computed:08X}")
        else:
            self.log("superblock CRC OK")

        bs       = fields["s_block_size"]
        ag_count = fields["s_ag_count"]
        ag_size  = fields["s_ag_size"]
        ag_desc_off = fields.get("s_ag_desc_off", 0)
        # AG-grow: AGs >= primary_count have their descriptor in the extension
        # region (ext_off); 0 = legacy / no grow -> all in the primary region.
        ag_prim     = fields.get("s_ag_desc_primary_count", 0)
        ag_ext_off  = fields.get("s_ag_desc_ext_off", 0)

        if bs not in (512, 1024, 2048, 4096, 8192):
            self.error(f"Unreasonable block size {bs}")
            return
        if ag_count == 0 or ag_count > 65536:
            self.error(f"Unreasonable AG count {ag_count}")
            return

        print(f"  Volume: {ag_count} AGs, block_size={bs}, "
              f"total={fields['s_total_blocks']} blocks, "
              f"free={fields['s_free_blocks']} blocks")

        # ── 2. AG descriptors ─────────────────────────────────────────────────
        print("Checking AG descriptors...")
        ags = []
        for ag_no in range(ag_count):
            if ag_prim and ag_no >= ag_prim:
                ag_block = ag_ext_off // bs + (ag_no - ag_prim)
            else:
                ag_block = ag_desc_off // bs + ag_no
            ag_raw   = read_block(f, ag_block, bs)
            try:
                ag = dict(zip(AG_HDR_FIELDS, struct.unpack_from(AG_HDR_FMT, ag_raw)))
            except struct.error:
                self.error(f"AG {ag_no}: descriptor too short")
                continue

            # ag_checksum lives at the tail of the descriptor block (offset bs-4).
            ag["ag_checksum"], = struct.unpack_from("<I", ag_raw, bs - 4)
            # Convenience aliases + AG-relative → absolute offset conversion.
            ag["ag_no"]            = ag["ag_number"]
            ag["block_start"]      = ag["ag_block_start"]
            ag["block_count"]      = ag["ag_block_count"]
            ag["free_blocks"]      = ag["ag_free_blocks"]
            ag["inode_count"]      = ag["ag_inode_count"]
            abs_base               = ag["ag_block_start"] * bs
            ag["bitmap_off"]       = abs_base + ag["ag_bitmap_off"]
            ag["bitmap_size"]      = ag["ag_bitmap_size"]
            ag["inode_table_off"]  = abs_base + ag["ag_inode_table_off"]
            ag["desc_byte_off"]    = ag_block * bs   # for in-place repair

            stored_ag_crc  = ag["ag_checksum"]
            computed_ag    = crc32c(ag_raw[:bs - 4])
            if ag["ag_magic"] != OCSFS_AG_MAGIC:
                self.error(f"AG {ag_no}: bad magic 0x{ag['ag_magic']:08X}")
            elif stored_ag_crc != computed_ag:
                self.error(f"AG {ag_no}: descriptor CRC mismatch "
                           f"(stored={stored_ag_crc:08X} computed={computed_ag:08X})")
            else:
                self.log(f"AG {ag_no}: CRC OK, blocks [{ag['block_start']}, "
                         f"{ag['block_start']+ag['block_count']})")
            ags.append(ag)

        # ── 3. Bitmap consistency + free block cross-check ────────────────────
        print("Checking allocation bitmaps...")
        total_bitmap_free = 0
        for ag in ags:
            ag_no = ag["ag_no"]
            bm_off = ag["bitmap_off"]
            bc     = ag["block_count"]
            bm_blocks = (bc + bs * 8 - 1) // (bs * 8)
            bitmap = b""
            for i in range(int(bm_blocks)):
                bitmap += read_block(f, bm_off // bs + i, bs)
            # Count allocated bits (1 = allocated, 0 = free, LE bit order)
            used = sum(bin(b).count("1") for b in bitmap[:bc // 8])
            free_from_bitmap = bc - used
            total_bitmap_free += free_from_bitmap
            ag_free_reported = ag["free_blocks"]
            if free_from_bitmap != ag_free_reported:
                # Approximate: bit-counting here doesn't model metadata reservation
                # or partial trailing bytes exactly, so treat as advisory only —
                # never let it drive a destructive repair.
                self.warn(f"AG {ag_no}: free_blocks approx mismatch — "
                          f"bitmap≈{free_from_bitmap}, "
                          f"AG descriptor={ag_free_reported} (advisory)")
            else:
                self.log(f"AG {ag_no}: {used} allocated, {free_from_bitmap} free (consistent)")

        # Cross-check total free blocks vs superblock (advisory — see above).
        sb_free = fields.get("s_free_blocks", 0)
        if sb_free != total_bitmap_free:
            self.warn(f"Superblock s_free_blocks={sb_free} ≈ "
                      f"sum of AG bitmap free={total_bitmap_free} (advisory)")

        # ── 4. Journal header ─────────────────────────────────────────────────
        # struct ocsfs_journal_header: magic u32, node_slot u16, flags u16,
        # head u64, tail u64, sequence u64, size u64, reserved[4052], checksum u32.
        # The header fills a full block; checksum is at offset (bs - 4).
        print("Checking journal headers...")
        JH_FMT = "<IHHQQQQ"   # up to jh_size; checksum read separately at bs-4
        max_nodes = fields["s_max_nodes"]
        # Use the authoritative offsets from the superblock, not hard-coded ones.
        JOURNAL_OFF       = fields["s_journal_off"]
        JOURNAL_NODE_SIZE = fields["s_journal_size"]
        for node in range(max_nodes):
            off = JOURNAL_OFF + node * JOURNAL_NODE_SIZE
            try:
                jh_raw = read_at(f, off, bs)
            except OSError:
                break
            (jh_magic, jh_node, jh_flags, jh_head,
             jh_tail, jh_seq, jh_size) = struct.unpack_from(JH_FMT, jh_raw)
            if jh_magic != OCSFS_JOURNAL_MAGIC:
                self.log(f"Journal slot {node}: not initialized (magic=0x{jh_magic:08X})")
                continue
            jh_crc, = struct.unpack_from("<I", jh_raw, bs - 4)
            computed_jh = crc32c(jh_raw[:bs - 4])
            if jh_crc != computed_jh:
                self.error(f"Journal slot {node}: header CRC mismatch "
                           f"(stored={jh_crc:08X} computed={computed_jh:08X})")
            else:
                self.log(f"Journal slot {node}: OK (head={jh_head} tail={jh_tail} "
                         f"seq={jh_seq})")

        # NOTE: the legacy fixed refcount-table spot-check was removed — refcounts
        # now live in a per-AG B+ tree (ag_rc_btree_root), so the old fixed offset
        # read garbage.  Auditing the refcount B+ tree is not yet reimplemented.

        # ── 5+. Extended checks ───────────────────────────────────────────────
        self._check_inodes(f, ags, bs)
        self._check_dedup_index(f, fields, ags, bs)
        self._check_heartbeat(f, bs, fields["s_max_nodes"])
        self._check_lock_table(f, bs)
        self._check_node_slots(f, fields["s_max_nodes"])

    def _block_allocated(self, f, ags, bs, block):
        """Return True if `block` is marked allocated in its AG bitmap."""
        for ag in ags:
            start = ag["block_start"]
            cnt   = ag["block_count"]
            if start <= block < start + cnt:
                bit = block - start
                byte = read_at(f, ag["bitmap_off"] + bit // 8, 1)
                return bool((byte[0] >> (bit % 8)) & 1)
        return False  # block outside every AG range

    def _walk_dedup_index(self, f, root, bs, total_blocks):
        """Collect all (fingerprint, canonical_block) leaf entries of the
        global dedup B+ tree by an iterative descent with a cycle guard."""
        entries = []
        visited = set()
        stack   = [root]
        while stack:
            blk = stack.pop()
            if blk in visited or blk == 0 or blk >= total_blocks:
                continue
            visited.add(blk)
            if len(visited) > 1_000_000:
                self.error("dedup index: node count exceeds sanity cap — aborting walk")
                break
            raw = read_block(f, blk, bs)
            hdr = dict(zip(BTREE_HDR_FIELDS,
                           struct.unpack_from(BTREE_HDR_FMT, raw)))
            magic = hdr["bn_magic"]
            count = hdr["bn_count"]
            if magic not in (OCSFS_BTREE_LEAF_MAGIC, OCSFS_BTREE_INTERNAL_MAGIC):
                self.error(f"dedup index: node {blk} bad magic 0x{magic:08X}")
                continue
            if hdr["bn_level"] == 0:        # leaf: key/value pairs
                for i in range(count):
                    k, v = struct.unpack_from("<QQ", raw, BTREE_HDR_SIZE + i * 16)
                    entries.append((k, v))
            else:                           # internal: first_child + (key,child) ptrs
                child0, = struct.unpack_from("<Q", raw, BTREE_HDR_SIZE)
                stack.append(child0)
                for i in range(count):
                    _, child = struct.unpack_from(
                        "<QQ", raw, BTREE_HDR_SIZE + 8 + i * 16)
                    stack.append(child)
        return entries

    def _check_dedup_index(self, f, fields, ags, bs):
        """Audit the cross-file dedup index (DDT): every canonical block it
        references must be allocated. An entry pointing at a free block is a
        dangling reference (kernel scrub GC prunes these; report only)."""
        if not (fields.get("s_feature_ro_compat", 0) &
                OCSFS_FEATURE_RO_COMPAT_DEDUP_INDEX):
            return
        print("Checking cross-file dedup index...")
        root = fields.get("s_dedup_index_root", 0)
        if root == 0:
            self.log("  dedup index: empty (no cross-file canonicals)")
            return
        total_blocks = fields["s_total_blocks"]
        entries  = self._walk_dedup_index(f, root, bs, total_blocks)
        dangling = invalid = 0
        for fp, blk in entries:
            if blk == 0 or blk >= total_blocks:
                self.error(f"  dedup index: fp={fp:016x} -> out-of-range block {blk}")
                invalid += 1
            elif not self._block_allocated(f, ags, bs, blk):
                self.warn(f"  dedup index: fp={fp:016x} -> FREE block {blk} (dangling)")
                dangling += 1
        msg = (f"  dedup index: {len(entries)} canonical block(s)"
               f"{f', {dangling} dangling' if dangling else ''}"
               f"{f', {invalid} invalid' if invalid else ''}")
        if dangling or invalid:
            self.warn(msg + " — remount writable to let the kernel scrub GC prune them")
        else:
            self.log(msg + " — all referenced blocks allocated")

    def _check_inodes(self, f, ags, bs):
        """Check every inode slot in each AG's inode table."""
        print("Checking inode tables...")
        total_valid = total_bad = total_orphan = 0

        for ag in ags:
            ag_no       = ag["ag_no"]
            itable_off  = ag["inode_table_off"]
            inode_count = ag["inode_count"]

            if itable_off == 0 or inode_count == 0:
                self.log(f"AG {ag_no}: inode table not initialised, skipping")
                continue

            valid = bad = orphan = reclaimed = 0
            for idx in range(inode_count):
                byte_off = itable_off + idx * OCSFS_INODE_SIZE
                try:
                    raw = read_at(f, byte_off, OCSFS_INODE_SIZE)
                except OSError as e:
                    self.error(f"AG {ag_no} inode {idx}: read error: {e}")
                    break

                magic, = struct.unpack_from("<I", raw, 0)
                if magic != OCSFS_INODE_MAGIC:
                    continue  # unallocated slot

                # CRC over everything except the last 4 bytes
                stored_crc, = struct.unpack_from("<I", raw, OCSFS_INODE_SIZE - 4)
                computed    = crc32c(raw[:OCSFS_INODE_SIZE - 4])
                if stored_crc != computed:
                    # A "reserved-but-unflushed" slot: ocsfs_alloc_inode_num
                    # stamps magic+ino and journals the slot, then the inode body
                    # is filled in by the first flush.  A crash in that window
                    # used to leave magic valid but checksum 0 and an empty body
                    # (mode=0, nlink=0).  Such a slot is safely reclaimable; a
                    # bad-CRC inode WITH a populated body is genuine corruption
                    # and is only reported.  (The kernel now stamps a valid CRC
                    # at allocation, so this is for older volumes + safety.)
                    e_mode,  = struct.unpack_from("<H", raw, 12)
                    e_nlink, = struct.unpack_from("<H", raw, 14)
                    e_size,  = struct.unpack_from("<Q", raw, 24)
                    empty = (e_mode == 0 and e_nlink == 0 and e_size == 0)
                    if empty:
                        self.error(f"AG {ag_no} inode {idx}: reserved-but-unflushed "
                                   f"slot (bad CRC, empty body)")
                        if self.repair:
                            f.seek(byte_off)
                            f.write(b"\x00" * OCSFS_INODE_SIZE)  # free the slot
                            reclaimed += 1
                            self.fix(f"AG {ag_no} inode {idx}: freed "
                                     f"reserved-but-unflushed slot")
                    else:
                        self.error(f"AG {ag_no} inode {idx}: CRC mismatch "
                                   f"(stored={stored_crc:08X} computed={computed:08X}) "
                                   f"— populated body, not auto-cleared")
                    bad += 1
                    continue

                # struct ocsfs_inode field offsets (packed):
                #   i_ino@4, i_mode@12, i_nlink@14, i_uid@16, i_gid@20, i_flags@64.
                ino, mode, nlink, uid, gid = struct.unpack_from("<QHHII", raw, 4)
                I_NLINK_OFF = 14
                I_FLAGS_OFF = 64
                i_flags, = struct.unpack_from("<I", raw, I_FLAGS_OFF)
                e_size, = struct.unpack_from("<Q", raw, 24)   # i_size @24
                is_orphan = bool(i_flags & OCSFS_IFLAG_ORPHAN) or (nlink == 0 and ino != 0)
                if is_orphan:
                    self.warn(f"AG {ag_no} inode {idx}: ino={ino} mode=0o{mode:06o} "
                              f"nlink={nlink} flags=0x{i_flags:04x} — orphan")
                    orphan += 1
                    if self.repair and mode == 0 and e_size == 0:
                        # Empty orphan (no body, no blocks) — e.g. an inode that
                        # was allocated but crashed before its first flush.  Free
                        # the slot outright and return it to the AG counter.
                        f.seek(byte_off)
                        f.write(b"\x00" * OCSFS_INODE_SIZE)
                        reclaimed += 1
                        self.fix(f"AG {ag_no} inode {idx}: freed empty orphan slot")
                    elif self.repair:
                        # Populated orphan (a deleted-but-was-open file): just
                        # normalise the flags/nlink; block reclaim is left to the
                        # kernel's evict path on the next mount.
                        patched = bytearray(raw)
                        struct.pack_into("<H", patched, I_NLINK_OFF, 0)
                        i_flags_new = i_flags & ~OCSFS_IFLAG_ORPHAN
                        struct.pack_into("<I", patched, I_FLAGS_OFF, i_flags_new)
                        new_crc = crc32c(bytes(patched[:OCSFS_INODE_SIZE - 4]))
                        struct.pack_into("<I", patched, OCSFS_INODE_SIZE - 4, new_crc)
                        f.seek(byte_off)
                        f.write(bytes(patched))
                        self.fix(f"AG {ag_no} inode {idx}: cleared ORPHAN flag, "
                                 f"nlink zeroed")
                else:
                    valid += 1
                    self.log(f"AG {ag_no} inode {idx}: ino={ino} mode=0o{mode:06o} "
                             f"nlink={nlink} OK")

            # Return any freed reserved-but-unflushed slots to the AG's
            # free-inode counter and re-stamp the descriptor CRC, so the
            # allocator (which skips an AG whose free_inodes == 0) can hand
            # them out again.  ag_free_inodes is at offset 72 in the 4096-byte
            # descriptor block; ag_checksum is the last 4 bytes.
            if self.repair and reclaimed > 0 and ag.get("desc_byte_off"):
                AG_FREE_INODES_OFF = 72
                dblk = read_at(f, ag["desc_byte_off"], bs)
                dbuf = bytearray(dblk)
                cur, = struct.unpack_from("<Q", dbuf, AG_FREE_INODES_OFF)
                struct.pack_into("<Q", dbuf, AG_FREE_INODES_OFF, cur + reclaimed)
                struct.pack_into("<I", dbuf, bs - 4, crc32c(bytes(dbuf[:bs - 4])))
                f.seek(ag["desc_byte_off"])
                f.write(bytes(dbuf))
                self.fix(f"AG {ag_no}: free_inodes {cur} -> {cur + reclaimed} "
                         f"after reclaiming {reclaimed} slot(s)")

            total_valid  += valid
            total_bad    += bad
            total_orphan += orphan
            self.log(f"AG {ag_no}: {valid} OK, {bad} bad CRC, {orphan} orphan")

        print(f"  Inodes: {total_valid} OK, {total_bad} bad CRC, "
              f"{total_orphan} orphaned")

    def _check_heartbeat(self, f, bs, max_nodes):
        """Check heartbeat entries for all node slots."""
        print("Checking heartbeat area...")
        active = stale_crc = unused = 0
        HB_STATE_ACTIVE = 1

        for slot in range(max_nodes):
            byte_off = OCSFS_HEARTBEAT_OFF + slot * OCSFS_HEARTBEAT_ENTRY
            try:
                raw = read_at(f, byte_off, OCSFS_HEARTBEAT_ENTRY)
            except OSError:
                break

            magic, = struct.unpack_from("<I", raw, 0)
            if magic != OCSFS_HEARTBEAT_MAGIC:
                unused += 1
                continue

            stored_crc, = struct.unpack_from("<I", raw, OCSFS_HEARTBEAT_ENTRY - 4)
            computed    = crc32c(raw[:OCSFS_HEARTBEAT_ENTRY - 4])
            if stored_crc != computed:
                self.error(f"Heartbeat slot {slot}: CRC mismatch "
                           f"(stored={stored_crc:08X} computed={computed:08X}) "
                           f"— entry may be corrupted")
                stale_crc += 1
                continue

            node_slot, state = struct.unpack_from("<HH", raw, 4)
            timestamp, sequence, mount_gen = struct.unpack_from("<QQI", raw, 8)
            state_str = "ACTIVE" if state == HB_STATE_ACTIVE else f"state={state}"
            self.log(f"Heartbeat slot {slot}: node={node_slot} {state_str} "
                     f"seq={sequence} mount_gen={mount_gen}")
            active += 1

        print(f"  Heartbeat: {active} active, {stale_crc} bad CRC, "
              f"{unused} unused slots")

    def _check_lock_table(self, f, bs):
        """Scan lock table; report stale held locks (EX/SH after crash)."""
        print("Checking lock table...")
        total = held = bad_crc = 0
        lock_table_size = 1048576  # OCSFS_LOCK_TABLE_SIZE
        n_entries = lock_table_size // OCSFS_LOCK_ENTRY_SIZE

        for idx in range(n_entries):
            byte_off = OCSFS_LOCK_TABLE_OFF + idx * OCSFS_LOCK_ENTRY_SIZE
            try:
                raw = read_at(f, byte_off, OCSFS_LOCK_ENTRY_SIZE)
            except OSError:
                break

            magic, = struct.unpack_from("<I", raw, 0)
            if magic != OCSFS_LOCK_MAGIC:
                continue

            total += 1
            stored_crc, = struct.unpack_from("<I", raw, OCSFS_LOCK_ENTRY_SIZE - 4)
            computed    = crc32c(raw[:OCSFS_LOCK_ENTRY_SIZE - 4])
            if stored_crc != computed:
                self.error(f"Lock entry {idx}: CRC mismatch — entry corrupt")
                bad_crc += 1
                continue

            res_id, res_type, mode, holder_slot = struct.unpack_from("<QIHH", raw, 4)
            mode_str = LOCK_MODES.get(mode, f"?{mode}")
            if mode >= 1:  # SH, CW, or EX
                held += 1
                self.warn(f"Lock entry {idx}: resource={res_id:#x} type={res_type} "
                          f"mode={mode_str} holder_slot={holder_slot} "
                          f"— may be stale after crash")
                if self.repair:
                    # Downgrade to NL: zero the entry, rewrite magic + NL mode + CRC
                    zeroed = bytearray(OCSFS_LOCK_ENTRY_SIZE)
                    struct.pack_into("<I", zeroed, 0, OCSFS_LOCK_MAGIC)
                    # le_mode field at offset 20 (magic 4 + res_id 8 + res_type 4 + 4)
                    struct.pack_into("<H", zeroed, 20, 0)   # mode = NL
                    new_crc = crc32c(bytes(zeroed[:OCSFS_LOCK_ENTRY_SIZE - 4]))
                    struct.pack_into("<I", zeroed, OCSFS_LOCK_ENTRY_SIZE - 4, new_crc)
                    f.seek(byte_off)
                    f.write(bytes(zeroed))
                    self.fix(f"Lock entry {idx}: downgraded {mode_str} → NL")
            else:
                self.log(f"Lock entry {idx}: resource={res_id:#x} NL (free)")

        print(f"  Lock table: {total} initialised entries, "
              f"{held} held (EX/SH/CW), {bad_crc} bad CRC")


    def _check_node_slots(self, f, max_nodes: int):
        """Check node slot table: magic, CRC, detect stale ACTIVE entries."""
        print("Checking node slot table...")
        active = free = bad_crc = stale_active = 0

        for slot in range(max_nodes):
            byte_off = OCSFS_NODE_SLOT_TABLE_OFF + slot * OCSFS_NODE_SLOT_SIZE
            try:
                raw = read_at(f, byte_off, OCSFS_NODE_SLOT_SIZE)
            except OSError:
                break

            try:
                ns = dict(zip(NS_FIELDS, struct.unpack_from(NS_FMT, raw)))
            except struct.error:
                self.error(f"Node slot {slot}: descriptor too short")
                continue

            state      = ns["ns_state"]
            state_str  = NODE_STATES.get(state, f"?{state:#x}")
            stored_crc = ns["ns_checksum"]

            # Free slots have zero uuid — skip CRC check
            if all(b == 0 for b in ns["ns_uuid"]):
                free += 1
                self.log(f"Node slot {slot}: free")
                continue

            computed = crc32c(raw[:OCSFS_NODE_SLOT_SIZE - 4])
            if stored_crc != computed:
                self.error(f"Node slot {slot}: CRC mismatch "
                           f"(stored={stored_crc:08X} computed={computed:08X})")
                bad_crc += 1
                continue

            name = ns["ns_name"].rstrip(b"\x00").decode("utf-8", errors="replace")
            self.log(f"Node slot {slot}: {state_str} node='{name}' "
                     f"mount_gen={ns['ns_mount_gen']}")

            if state == 0x01:   # OCSFS_NODE_ACTIVE
                active += 1
                stale_active += 1
                self.warn(f"Node slot {slot}: ACTIVE after unmount — "
                          f"node='{name}' (stale after crash?)")
                if self.repair:
                    patched = bytearray(raw)
                    patched[16 + 64] = 0xFF  # ns_state = DEAD
                    new_crc = crc32c(bytes(patched[:OCSFS_NODE_SLOT_SIZE - 4]))
                    struct.pack_into("<I", patched, OCSFS_NODE_SLOT_SIZE - 4, new_crc)
                    f.seek(byte_off)
                    f.write(bytes(patched))
                    self.fix(f"Node slot {slot}: marked DEAD (was stale ACTIVE)")
            elif state in (0x00, 0xFF):  # FREE or DEAD
                free += 1

        print(f"  Node slots: {active} active, {free} free/dead, "
              f"{bad_crc} bad CRC, {stale_active} stale")


def main():
    parser = argparse.ArgumentParser(
        description="OCSFS offline filesystem checker",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=__doc__
    )
    parser.add_argument("device", help="Block device or image file to check")
    parser.add_argument("-n", "--dry-run", action="store_true",
                        help="Read-only check, never write (overrides -r)")
    parser.add_argument("-r", "--repair", action="store_true",
                        help="Repair recoverable errors (stale locks, orphan inodes, "
                             "stale ACTIVE node slots)")
    parser.add_argument("-v", "--verbose", action="store_true",
                        help="Show details for each check")
    args = parser.parse_args()

    if not os.path.exists(args.device):
        print(f"ocsfs-fsck: {args.device}: not found", file=sys.stderr)
        sys.exit(2)

    if args.repair and not args.dry_run:
        print(f"ocsfs-fsck: REPAIR MODE — will modify {args.device}")
    else:
        print(f"ocsfs-fsck: checking {args.device}")

    fsck = Fsck(args.device, dry_run=args.dry_run, verbose=args.verbose,
                repair=args.repair)
    sys.exit(fsck.check())


if __name__ == "__main__":
    main()
