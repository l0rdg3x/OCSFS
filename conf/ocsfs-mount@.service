#
# ocsfs-mount@.service — Auto-mount an OCSFS filesystem
#
# This is a template unit. The instance name encodes the device and mount point:
#   systemctl enable ocsfs-mount@fc\\x2dshared.service
#
# For production use, prefer /etc/fstab entries or Proxmox storage.cfg.
# This unit is provided for standalone deployments without Proxmox.
#
# Configuration via /etc/ocsfs/<instance>.conf:
#   OCSFS_DEVICE=/dev/mapper/mpath-3600508b...
#   OCSFS_MOUNTPOINT=/mnt/ocsfs/%i
#   OCSFS_OPTIONS=defaults

[Unit]
Description=Mount OCSFS filesystem %I
After=local-fs-pre.target multipathd.service iscsid.service
Before=local-fs.target
DefaultDependencies=no

[Service]
Type=oneshot
RemainAfterExit=yes
EnvironmentFile=/etc/ocsfs/%i.conf
ExecStartPre=/sbin/modprobe ocsfs
ExecStart=/bin/mount -t ocsfs ${OCSFS_OPTIONS:+-o ${OCSFS_OPTIONS}} ${OCSFS_DEVICE} ${OCSFS_MOUNTPOINT}
ExecStop=/bin/umount ${OCSFS_MOUNTPOINT}

[Install]
WantedBy=local-fs.target
