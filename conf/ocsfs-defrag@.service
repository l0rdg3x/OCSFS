#
# ocsfs-defrag@.service — Online defragmentation for OCSFS
#
# Usage:
#   systemctl enable ocsfs-defrag@mnt-pve-fc\\x2dshared.service
#   systemctl start  ocsfs-defrag@mnt-pve-fc\\x2dshared.service
#
# The instance name is the systemd-escaped mount point path.
# Use `systemd-escape -p /mnt/pve/fc-shared` to get the escaped form.

[Unit]
Description=OCSFS online defragmentation for /%I
After=local-fs.target
RequiresMountsFor=/%I
ConditionPathIsMountPoint=/%I

[Service]
Type=simple
ExecStart=/usr/sbin/ocsfs-defrag -b 50 -t 4 /%I
ExecReload=/bin/kill -USR2 $MAINPID

# Pause on reload, resume on restart
Restart=on-failure
RestartSec=60

# Resource limits — avoid impacting VM workloads
Nice=19
IOSchedulingClass=idle
IOSchedulingPriority=7
CPUWeight=10
MemoryMax=256M

# Security hardening
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/%I
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
